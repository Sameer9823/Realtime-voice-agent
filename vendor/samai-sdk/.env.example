# Copy this file to .env (same folder) and fill in whichever keys you have.
# The demo auto-selects a provider: Anthropic if ANTHROPIC_API_KEY is set, else OpenAI
# if OPENAI_API_KEY is set. You only need ONE of these two for chat + structured output.
# TAVILY_API_KEY additionally enables the web_search tool in the demo.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=

# Force a specific provider instead of auto-detecting (optional): openai | anthropic
SAMAI_PROVIDER=

# Optional — only needed if you test other providers directly (examples/basic.ts etc.)
GOOGLE_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
BRAVE_API_KEY=
