+    voice?: {
+        voiceId?: string;
+        interruption?: "always-allow" | "confidence-gated" | "disabled";
+        backchannel?: boolean;
+        maxSilenceMs?: number;
+    };
+}
+interface VoiceConnectOptions {
+    agent: VoiceAgentConfig;
+    session?: Session;
+    onApprovalRequest?: (req: {
+        toolName: string;
+        args: unknown;
+    }) => Promise<boolean>;
+}
+/** Transport-level connection state, surfaced to callers so they can drive reconnect logic. */
+type VoiceConnectionState = "idle" | "connecting" | "connected" | "reconnecting" | "closed" | "failed";
