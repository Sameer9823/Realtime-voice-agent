# OpenAI API key — used ONLY on the server, to mint short-lived ephemeral credentials for the
# browser. Never expose this to client code and never rename it to a NEXT_PUBLIC_ variable.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional. Realtime model to use. Defaults to the app's own default when unset.
# OPENAI_REALTIME_MODEL=

# Optional. Voice preset for the assistant. One of: alloy, ash, ballad, coral, echo, sage,
# shimmer, verse, marin, cedar.
# OPENAI_REALTIME_VOICE=

# Optional. Override the OpenAI API base URL (e.g. for a proxy).
# OPENAI_BASE_URL=

# Optional. Error reporting. Leave blank to disable it entirely — the app installs no telemetry
# dependency, so this only takes effect if you also `npm install @sentry/nextjs` yourself.
# SENTRY_DSN=