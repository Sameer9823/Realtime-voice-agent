# ─── Required ──────────────────────────────────────────────────────────────────

# OpenAI API key — used ONLY on the server, to mint short-lived ephemeral credentials for the
# browser. Never expose this to client code and never rename it to a NEXT_PUBLIC_ variable.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ─── Realtime session (all optional) ───────────────────────────────────────────

# Realtime model to use. Defaults to `gpt-realtime` when unset.
# OPENAI_REALTIME_MODEL=

# Voice preset for the assistant. One of: alloy, ash, ballad, coral, echo, fable, marin, nova,
# onyx, sage, shimmer, verse. Defaults to `marin`.
# OPENAI_REALTIME_VOICE=

# Override the OpenAI API base URL (e.g. for a proxy or gateway).
# OPENAI_BASE_URL=

# ─── Tools (all optional) ──────────────────────────────────────────────────────

# Tavily key for the web-search tool. Without it the tool tells the model it is unavailable
# rather than failing the turn. Server-only, and never a NEXT_PUBLIC_ variable.
# Get one at https://app.tavily.com
# TAVILY_API_KEY=

# ─── Authentication (all optional) ─────────────────────────────────────────────

# Off by default: the app runs fully open with no configuration. Set to `true` to require a
# signed-in user before any session can be minted.
# REQUIRE_AUTH=

# Required by NextAuth whenever REQUIRE_AUTH=true. Generate with `openssl rand -base64 32`.
# Generate one even when auth is off if you plan to switch it on without a redeploy of secrets.
# AUTH_SECRET=

# GitHub OAuth, active as soon as both are set. This is the provider to use in production:
# no password storage and a real identity provider.
# Register an OAuth app at https://github.com/settings/developers with the callback
# https://your-host/api/auth/callback/github
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# Shared email and password, active as soon as both are set. A convenience for trying the gate
# out without registering an OAuth app — it is a shared secret, not a user store, so prefer
# GitHub for anything public. Setting only one of the two leaves the provider unregistered.
# AUTH_EMAIL=
# AUTH_PASSWORD=

# ─── Rate limiting (all optional) ──────────────────────────────────────────────

# Per-client request budget and window. Defaults: 20 requests per 60s.
# RATE_LIMIT_MAX=
# RATE_LIMIT_WINDOW_MS=

# Deployment-wide cap, so one abusive client cannot exhaust the account. Defaults: 600 per hour.
# Set to 0 to disable the global cap entirely.
# GLOBAL_CAP_MAX=
# GLOBAL_CAP_WINDOW_MS=

# Origins allowed to call the API, comma-separated. Unset means same-origin only, with no Origin
# header required, which is correct for a browser-first app. Set this when the frontend and API
# are served from different hosts.
# ALLOWED_ORIGINS=

# Shared rate-limit store, so limits hold across more than one instance. The default in-memory
# limiter is correct for a single Node process but multiplies the effective limit by the replica
# count. Requires `npm install @upstash/redis`; without it the app falls back to in-memory.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# RATE_LIMIT_PREFIX=

# ─── Session limits (optional) ─────────────────────────────────────────────────

# Hard cap on one conversation, in minutes, readable by the browser so it can show a countdown.
# 0 or unset means uncapped.
# NEXT_PUBLIC_MAX_SESSION_MINUTES=

# ─── Observability (optional) ──────────────────────────────────────────────────

# Error reporting. Leave blank to disable it entirely — the app installs no telemetry dependency,
# so this only takes effect if you also `npm install @sentry/nextjs` yourself.
# SENTRY_DSN=
